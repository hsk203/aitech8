---
import { t, formatDate } from "../../i18n";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCover from "../../components/posts/PostCover.vue";
import { getPosts, summarize, getPostId } from "../../lib/posts";
import { categoryLabel } from "../../data/post-options";
import { personalInfo } from "../../config";
import { withBase } from "../../lib/url";
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { id: getPostId(post) },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = (await getPosts()).map(summarize);
const summary = summarize(post);
const tool = post.data;
const pricingLabels: Record<string, string> = {
  free: t("tool.free"),
  freemium: t("tool.freemium"),
  paid: t("tool.paid"),
};
const hasToolInfo = Boolean(
  tool.pricingModel ||
  tool.startingPrice ||
  tool.needVPN !== undefined ||
  tool.cnAlternative ||
  tool.affiliateUrl ||
  tool.updatedDate,
);
const index = posts.findIndex((item) => item.id === getPostId(post));
const newer = posts[index - 1];
const older = posts[index + 1];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={
    post.data.coverImage?.endsWith(".svg")
      ? undefined
      : post.data.coverImage
  }
  heroTitle={t("article.heroTitle")}
  heroSubtitle={t("article.heroSubtitle")}
  article
  publishedTime={post.data.date.toISOString()}
>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <div class="shell article-layout">
    <article class="card article-detail">
      <a href={withBase("/posts/")} class="text-link">
        <span class="icon-[lucide--arrow-left]" aria-hidden="true"></span>
        {t("article.back")}
      </a>
      <header class="article-header">
        <a
          class="chip"
          href={withBase(
            `/posts/?category=${encodeURIComponent(post.data.category)}`,
          )}
        >
          {categoryLabel(post.data.category)}
        </a>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <img
            src={personalInfo.avatar}
            alt=""
            width="25"
            height="25"
            decoding="async"
          />
          <span>{personalInfo.name}</span>
          <span>·</span>
          <time datetime={summary.date}>{formatDate(summary.date)}</time>
          <span>·</span>
          <span>{t("article.readingTime", { count: summary.minutes })}</span>
        </div>
        <p>{post.data.description}</p>
      </header>
      <div class="article-cover">
        <PostCover
          kind={post.data.cover}
          featured={post.data.featured}
          image={post.data.coverImage}
          alt={post.data.title}
        />
      </div>
      {hasToolInfo && (
        <section class="tool-info" aria-label={t("tool.infoTitle")}>
          <h2>{t("tool.infoTitle")}</h2>
          <dl>
            {tool.pricingModel && (
              <div>
                <dt>{t("tool.pricingModel")}</dt>
                <dd>{pricingLabels[tool.pricingModel]}</dd>
              </div>
            )}
            {tool.startingPrice && (
              <div>
                <dt>{t("tool.startingPrice")}</dt>
                <dd>{tool.startingPrice}</dd>
              </div>
            )}
            {tool.needVPN !== undefined && (
              <div>
                <dt>{t("tool.needVPN")}</dt>
                <dd>
                  {tool.needVPN ? t("tool.needVPNYes") : t("tool.needVPNNo")}
                </dd>
              </div>
            )}
            {tool.cnAlternative && (
              <div>
                <dt>{t("tool.cnAlternative")}</dt>
                <dd>{tool.cnAlternative}</dd>
              </div>
            )}
            {tool.updatedDate && (
              <div>
                <dt>{t("tool.updatedDate")}</dt>
                <dd>{formatDate(tool.updatedDate)}</dd>
              </div>
            )}
          </dl>
          {tool.affiliateUrl && (
            <a
              class="tool-link"
              href={tool.affiliateUrl}
              target="_blank"
              rel="noopener noreferrer sponsored"
            >
              {t("tool.officialSite")}
              <span
                class="icon-[lucide--arrow-up-right]"
                aria-hidden="true"
              ></span>
            </a>
          )}
        </section>
      )}
      <details class="mobile-toc" id="mobile-toc-origin">
        <summary>{t("article.toc")}</summary>
        <ol>
          {headings
            .filter((h) => h.depth <= 3)
            .map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
        </ol>
      </details>
      <div class="ad-slot ad-slot-inline" data-ad-slot="article-top" aria-label="Advertisement"><span>ADVERTISEMENT</span></div>
      <div class="prose" id="article-body">
        <Content />
      </div>
      <div class="article-ending">
        <span>✿</span>
        <p>{t("article.thanks")}</p>
      </div>
      <div class="article-tools">
        <div class="article-tags">
          {post.data.tags.map((tag) => (
            <a
              class="chip"
              href={withBase(`/posts/?tag=${encodeURIComponent(tag)}`)}
            >
              # {tag}
            </a>
          ))}
        </div>
        <button id="share-post" class="btn secondary">
          <span class="icon-[lucide--link]" aria-hidden="true"></span>
          {t("article.share")}
        </button>
      </div>
      <p id="share-status" role="status" class="share-status"></p>
      <div class="author-note">
        <img
          src={personalInfo.avatar}
          alt={personalInfo.name}
          width="44"
          height="44"
          loading="lazy"
          decoding="async"
        />
        <div>
          <strong>
            {personalInfo.name}{" "}
            <span class="accent">/ {personalInfo.englishName}</span>
          </strong>
          <p>
            {t("article.authorNote")}{" "}
            <a
              href={personalInfo.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          </p>
        </div>
      </div>
      <nav class="adjacent-posts" aria-label={t("article.adjacent")}>
        {newer ? (
          <a href={withBase(`/posts/${newer.id}/`)}>
            <span>{t("article.previous")}</span>
            <strong>{newer.title}</strong>
          </a>
        ) : (
          <div></div>
        )}
        {older && (
          <a href={withBase(`/posts/${older.id}/`)}>
            <span>{t("article.next")}</span>
            <strong>{older.title}</strong>
          </a>
        )}
      </nav>
    </article>
    <aside class="article-sidebar">
      <nav class="card panel toc" aria-label={t("article.toc")}>
        <div class="toc-header">
          <button
            class="toc-header-btn"
            id="toc-collapse"
            type="button"
            aria-label={t("article.tocCollapse")}
          >
            <span
              class="icon-[lucide--layout-dashboard]"
              aria-hidden="true"
            ></span>
          </button>
          <span class="toc-header-pill">
            <span class="icon-[lucide--list-ordered]" aria-hidden="true"></span>
            {t("article.toc")}
          </span>
          <button
            class="toc-header-btn"
            id="toc-toggle-sub"
            type="button"
            aria-label={t("article.tocToggleSub")}
          >
            <span class="icon-[lucide--newspaper]" aria-hidden="true"></span>
          </button>
        </div>
        <ol>
          {(() => {
            let h2 = 0;
            let h3 = 0;
            return headings
              .filter((h) => h.depth <= 3)
              .map((h) => {
                let num: string;
                if (h.depth === 2) {
                  h2 += 1;
                  h3 = 0;
                  num = String(h2).padStart(2, "0");
                } else {
                  h3 += 1;
                  num = `${h2}.${h3}`;
                }
                return (
                  <li class:list={{ nested: h.depth === 3 }}>
                    <a href={`#${h.slug}`} data-heading={h.slug}>
                      <span>{num}</span>
                      {h.text}
                    </a>
                  </li>
                );
              });
          })()}
        </ol>
      </nav>
      <div class="ad-slot ad-slot-sidebar" data-ad-slot="article-sidebar" aria-label="Advertisement"><span>ADVERTISEMENT</span></div>
    </aside>
  </div>
  <div class="mobile-toc-float" id="mobile-toc-float" aria-hidden="true">
    <button class="mobile-toc-trigger" id="mobile-toc-trigger" type="button" aria-expanded="false" aria-controls="mobile-toc-panel">
      <span class="icon-[lucide--list]" aria-hidden="true"></span>
      <span id="mobile-toc-current">{t("article.toc")}</span>
      <span class="icon-[lucide--chevron-down]" aria-hidden="true"></span>
    </button>
    <nav class="mobile-toc-panel" id="mobile-toc-panel" aria-label={t("article.toc")} hidden>
      <ol>{headings.filter((h) => h.depth <= 3).map((h) => <li><a href={`#${h.slug}`} data-heading={h.slug}>{h.text}</a></li>)}</ol>
    </nav>
  </div>
  <script>
    import { t } from "../../i18n";
    const body = document.querySelector<HTMLElement>("#article-body");
    const progress = document.querySelector<HTMLElement>("#reading-progress");
    const tocLinks = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-heading]"),
    ];
    const mobileCurrent = document.querySelector<HTMLElement>("#mobile-toc-current");
    const update = () => {
      if (!body || !progress) return;
      const top = body.getBoundingClientRect().top + window.scrollY;
      const distance = Math.max(
        1,
        body.offsetHeight - window.innerHeight + 130,
      );
      progress.style.width = `${Math.min(100, Math.max(0, ((window.scrollY - top + 100) / distance) * 100))}%`;
      let current = "";
      for (const link of tocLinks) {
        const heading = document.getElementById(link.dataset.heading || "");
        if (heading && heading.getBoundingClientRect().top <= 150)
          current = link.dataset.heading || "";
      }
      tocLinks.forEach((link) => {
        const selected = link.dataset.heading === current;
        link.classList.toggle("active", selected);
        selected
          ? link.setAttribute("aria-current", "location")
          : link.removeAttribute("aria-current");
      });
      const currentLink = tocLinks.find((link) => link.dataset.heading === current);
      if (mobileCurrent && currentLink) mobileCurrent.textContent = currentLink.textContent?.trim() || t("article.toc");
    };
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
    const tocNav = document.querySelector<HTMLElement>("nav.toc");
    const mobileFloat = document.querySelector<HTMLElement>("#mobile-toc-float");
    const mobileOrigin = document.querySelector<HTMLElement>("#mobile-toc-origin");
    const mobileTrigger = document.querySelector<HTMLButtonElement>("#mobile-toc-trigger");
    const mobilePanel = document.querySelector<HTMLElement>("#mobile-toc-panel");
    const closeMobileToc = () => {
      mobileFloat?.classList.remove("is-open");
      mobileTrigger?.setAttribute("aria-expanded", "false");
      if (mobilePanel) mobilePanel.hidden = true;
    };
    mobileTrigger?.addEventListener("click", () => {
      const open = mobileTrigger.getAttribute("aria-expanded") !== "true";
      mobileTrigger.setAttribute("aria-expanded", String(open));
      mobileFloat?.classList.toggle("is-open", open);
      if (mobilePanel) mobilePanel.hidden = !open;
    });
    mobilePanel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMobileToc));
    if (mobileOrigin && mobileFloat && "IntersectionObserver" in window) {
      const tocObserver = new IntersectionObserver(([entry]) => {
        const pastOrigin = !entry.isIntersecting && entry.boundingClientRect.top < 72;
        mobileFloat.classList.toggle("is-visible", pastOrigin);
        mobileFloat.setAttribute("aria-hidden", String(!pastOrigin));
        if (!pastOrigin) closeMobileToc();
      }, { threshold: 0, rootMargin: "-72px 0px 0px 0px" });
      tocObserver.observe(mobileOrigin);
    }
    const paragraphs = body?.querySelectorAll<HTMLElement>(":scope > p");
    if (body && paragraphs && paragraphs.length >= 4) {
      const middle = paragraphs[Math.floor(paragraphs.length / 2)];
      const ad = document.createElement("aside");
      ad.className = "ad-slot ad-slot-inline ad-slot-middle";
      ad.dataset.adSlot = "article-middle";
      ad.setAttribute("aria-label", "Advertisement");
      ad.innerHTML = "<span>ADVERTISEMENT</span>";
      middle?.after(ad);
    }
    document.querySelector("#toc-collapse")?.addEventListener("click", () => {
      tocNav?.classList.toggle("toc-collapsed");
    });
    document.querySelector("#toc-toggle-sub")?.addEventListener("click", () => {
      tocNav?.classList.toggle("toc-hide-sub");
    });
    document
      .querySelector("#share-post")
      ?.addEventListener("click", async () => {
        const status = document.querySelector<HTMLElement>("#share-status");
        try {
          await navigator.clipboard.writeText(
            window.location.href.split("#")[0],
          );
          if (status) status.textContent = t("article.shared");
        } catch {
          if (status)
            status.textContent = t("article.shareFallback", {
              url: window.location.href.split("#")[0],
            });
        }
      });
    document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
      const code = pre.querySelector("code");
      if (!code) return;
      const button = document.createElement("button");
      button.className = "copy-code";
      button.textContent = t("article.copy");
      button.setAttribute("aria-label", t("article.copyCode"));
      button.setAttribute("aria-live", "polite");
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.textContent || "");
          button.textContent = t("article.copied");
        } catch {
          button.textContent = t("article.copyFallback");
        }
        setTimeout(() => {
          button.textContent = t("article.copy");
        }, 2500);
      });
      pre.append(button);
    });
  </script>
</BaseLayout>
<style>
  .article-layout {
    max-width: 1280px;
    display: grid;
    grid-template-columns: 235px minmax(0, 1fr);
    gap: 25px;
    align-items: start;
    padding-top: 20px;
    padding-bottom: 45px;
  }
  .article-detail {
    padding: 35px;
    min-width: 0;
    order: 2;
  }
  .article-header {
    padding-top: 22px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 11px;
  }
  .article-meta img {
    border-radius: 50%;
  }
  .article-header > p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
    margin: 20px 0;
  }
  .article-cover {
    border-radius: 12px;
    overflow: hidden;
    height: 230px;
  }
  .article-cover :global(.cover-icon) {
    font-size: 58px;
  }
  .article-cover :global(strong) {
    font-size: 35px;
  }
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 90px;
    order: 1;
  }
  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 4px;
    margin: 0 0 14px;
  }
  .toc-header-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .toc-header-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border: none;
    background: transparent;
    color: var(--muted);
    border-radius: 50%;
    cursor: pointer;
    font-size: 15px;
    padding: 0;
  }
  .toc-header-btn:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--card));
  }
  .toc.toc-collapsed ol {
    display: none;
  }
  .toc.toc-hide-sub li.nested {
    display: none;
  }
  .toc ol {
    list-style: none;
    padding: 0 0 0 16px;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .toc li {
    position: relative;
  }
  .toc li::before {
    content: "";
    position: absolute;
    left: -19px;
    top: 1.05em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--card);
  }
  .toc li:has(a.active)::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .toc li {
    margin: 11px 0;
    line-height: 1.8;
  }
  .toc a {
    display: flex;
    gap: 9px;
    font-size: 12px;
    color: var(--muted);
    border-radius: 8px;
    padding: 3px 8px;
    margin: 0 -8px;
  }
  .toc a span {
    color: var(--accent);
    font:
      11px/2 "Oxanium-Medium",
      var(--font-body);
    flex-shrink: 0;
  }
  .toc a.active,
  .toc a:hover {
    color: var(--accent);
  }
  .toc a.active {
    background: var(--accent-soft);
  }
  .toc .nested {
    margin-left: 12px;
  }
  .reading-progress {
    position: fixed;
    top: 70px;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--accent);
    z-index: 41;
  }
  .article-ending {
    margin: 40px 0 28px;
    text-align: center;
    color: var(--muted);
    font-size: 12px;
  }
  .article-ending > span {
    color: var(--accent);
    font-size: 26px;
  }
  .article-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .article-tools .btn {
    font-size: 11px;
    padding: 8px 12px;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .share-status {
    color: var(--accent);
    font-size: 12px;
  }
  .author-note {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px;
    border-radius: 12px;
    background: var(--accent-soft);
  }
  .author-note img {
    border-radius: 13px;
  }
  .author-note strong {
    font-size: 13px;
    font-weight: 400;
  }
  .author-note p {
    font-size: 12px;
    color: var(--muted);
    margin: 4px 0 0;
  }
  .author-note a {
    color: var(--accent);
  }
  .adjacent-posts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    margin-top: 27px;
  }
  .adjacent-posts a {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .adjacent-posts a:last-child {
    text-align: right;
  }
  .adjacent-posts span {
    color: var(--muted);
    font-size: 12px;
  }
  .adjacent-posts strong {
    font-size: 13px;
    font-weight: 500;
  }
  .adjacent-posts a:hover {
    color: var(--accent);
  }
  .mobile-toc {
    display: none;
  }
  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      max-width: 800px;
    }
    .article-sidebar {
      display: none;
    }
    .mobile-toc {
      display: block;
      background: var(--accent-soft);
      padding: 15px 20px;
      border-radius: 12px;
      margin: 25px 0;
      color: var(--accent);
      font-size: 13px;
    }
    .mobile-toc summary {
      cursor: pointer;
    }
    .mobile-toc ol {
      padding-left: 18px;
      margin: 12px 0 0;
    }
    .mobile-toc li {
      margin: 8px 0;
    }
  }
  @media (max-width: 760px) {
    .article-detail {
      padding: 24px 20px;
    }
    .article-cover {
      height: 185px;
    }
    .reading-progress {
      top: 62px;
    }
  }
</style>

<style>
  .tool-info {
    margin: 26px 0;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--accent-soft);
  }
  .tool-info h2 {
    font-size: 15px;
    margin: 0 0 12px;
  }
  .tool-info dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px 18px;
    margin: 0 0 14px;
  }
  .tool-info dl div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tool-info dt {
    font-size: 12px;
    color: var(--muted);
  }
  .tool-info dd {
    margin: 0;
    font-size: 13px;
  }
  .tool-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    text-decoration: none;
  }
</style>

<style>
  .article-detail {
    border-top: 4px solid var(--accent);
    border-radius: 20px;
    box-shadow: 0 20px 54px color-mix(in srgb, var(--text) 7%, transparent);
  }
  .article-header {
    max-width: 78ch;
    padding-top: 18px;
  }
  .article-header h1 {
    font-size: clamp(30px, 3.1vw, 40px);
    line-height: 1.28;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 16px 0;
  }
  .article-header > .chip {
    border-radius: 999px;
    padding: 5px 12px;
    font-weight: 600;
  }
  .article-header > p {
    padding-left: 15px;
    border-left: 3px solid var(--accent-2);
    font-size: 15px;
    line-height: 1.85;
  }
  .article-meta {
    font-size: 12px;
  }
  .article-meta img {
    border: 2px solid var(--accent-soft);
  }
  .article-cover {
    height: clamp(220px, 30vw, 340px);
    border-radius: 18px;
    box-shadow: 0 14px 32px color-mix(in srgb, var(--text) 12%, transparent);
  }
  .article-sidebar > * {
    border-radius: 18px;
  }
  .article-sidebar .toc {
    border-color: color-mix(in srgb, var(--accent) 16%, var(--line));
    background: linear-gradient(
      145deg,
      var(--card),
      color-mix(in srgb, var(--accent-soft) 48%, var(--card))
    );
  }
  .reading-progress {
    height: 4px;
    background: var(--accent-gradient);
    box-shadow: 0 1px 10px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .tool-info {
    border-left: 4px solid var(--accent-2);
    border-radius: 16px;
    background: linear-gradient(
      120deg,
      color-mix(in srgb, var(--accent-2) 9%, var(--card)),
