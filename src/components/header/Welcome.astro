---
import { t } from "../../i18n";
import { welcomeConfig } from "../../config";
interface Props {
  compact?: boolean;
  title?: string;
  subtitle?: string;
  headingLevel?: 1 | 2;
}
const { compact = false, title, subtitle, headingLevel = 1 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<section class:list={["welcome-section", { compact }]} aria-label={title || welcomeConfig.title}>
  <div class="hero-shell">
    <div class="hero-content">
      <span class="hero-eyebrow"><span class="hero-pulse" aria-hidden="true"></span>{compact ? t("hero.pageEyebrow") : t("hero.homeEyebrow")}</span>
      <Heading class="hero-title">{title || welcomeConfig.title}</Heading>
      <p>{subtitle || welcomeConfig.subTitle}</p>
      {!compact && (
        <div class="hero-actions">
          <a href="#main-content" class="hero-primary">{t("hero.explore")} <span aria-hidden="true">→</span></a>
          <span class="hero-proof">Independent research <i></i> Practical comparisons <i></i> Real workflows</span>
        </div>
      )}
    </div>
    {!compact && (
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="visual-core"><span class="core-glyph">AI</span><span class="core-caption">INTELLIGENCE, APPLIED</span></div>
        <span class="visual-node node-one"></span><span class="visual-node node-two"></span><span class="visual-node node-three"></span>
        <span class="visual-label label-one">COMPARE</span><span class="visual-label label-two">CREATE</span><span class="visual-label label-three">AUTOMATE</span>
      </div>
    )}
  </div>
  {!compact && <div class="hero-bottom-line" aria-hidden="true"><span>AITech8 / RESEARCH NOTES</span><span>MAKE BETTER AI DECISIONS</span></div>}
</section>
<style>
  .welcome-section { position:relative; overflow:hidden; isolation:isolate; color:#fff; background:radial-gradient(ellipse at 78% 42%,rgba(100,87,255,.34),transparent 34%),radial-gradient(ellipse at 12% 100%,rgba(43,105,255,.22),transparent 38%),linear-gradient(112deg,#101a3b 0%,#17245a 53%,#20194e 100%); padding:112px 28px 72px; min-height:430px; }
  .welcome-section::before { content:""; position:absolute; inset:0; z-index:-1; opacity:.14; background-image:linear-gradient(rgba(255,255,255,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.16) 1px,transparent 1px); background-size:56px 56px; mask-image:linear-gradient(90deg,black,transparent 82%); }
  .welcome-section::after { content:""; position:absolute; width:560px; height:560px; right:-170px; top:-300px; border:1px solid rgba(175,174,255,.22); border-radius:50%; box-shadow:0 0 0 45px rgba(175,174,255,.035),0 0 0 90px rgba(175,174,255,.025); z-index:-1; }
  .hero-shell { width:min(1180px,100%); min-height:250px; margin:0 auto; display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.8fr); align-items:center; gap:48px; }
  .hero-content { position:relative; z-index:2; max-width:700px; }
  .hero-eyebrow { display:inline-flex; align-items:center; gap:9px; padding:7px 12px; border:1px solid rgba(186,190,255,.32); border-radius:999px; color:#d8dcff; background:rgba(255,255,255,.07); font:10px "Oxanium-Medium",var(--font-body); letter-spacing:.16em; }
  .hero-pulse { width:7px; height:7px; border-radius:50%; background:#76e2d4; box-shadow:0 0 0 4px rgba(118,226,212,.13); }
  .hero-title { max-width:780px; margin:22px 0 16px; color:#fff; font-size:clamp(38px,5.1vw,62px); font-weight:750; letter-spacing:-.055em; line-height:1.06; text-wrap:balance; }
  .hero-title :global(.gradient-text) { background:linear-gradient(100deg,#aeb8ff,#c6aaff 55%,#72e3db); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .hero-content > p { max-width:61ch; margin:0; color:rgba(239,242,255,.8); font-size:15px; line-height:1.85; }
  .hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:20px; margin-top:27px; }
  .hero-primary { display:inline-flex; align-items:center; gap:14px; padding:12px 17px; border-radius:10px; background:linear-gradient(105deg,#6473ff,#8b66f4); color:#fff; font-size:12px; font-weight:700; box-shadow:0 10px 28px rgba(76,76,222,.28); }
  .hero-primary:hover { transform:translateY(-2px); box-shadow:0 14px 32px rgba(76,76,222,.4); }
  .hero-proof { display:flex; align-items:center; flex-wrap:wrap; gap:8px; color:rgba(220,225,255,.62); font-size:10px; }
  .hero-proof i { width:3px; height:3px; border-radius:50%; background:#8e8bff; }
  .hero-visual { position:relative; min-height:270px; display:grid; place-items:center; }
  .visual-orbit { position:absolute; width:230px; height:230px; border:1px solid rgba(171,174,255,.35); border-radius:50%; transform:rotate(-24deg) scaleX(1.35); }
  .orbit-two { width:300px; height:150px; border-color:rgba(115,224,217,.25); transform:rotate(35deg); }
  .hero-visual::before { content:""; position:absolute; width:185px; height:185px; border-radius:50%; background:radial-gradient(circle,rgba(111,101,255,.34),rgba(111,101,255,.04) 68%,transparent 72%); filter:blur(3px); }
  .visual-core { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; width:142px; height:142px; border:1px solid rgba(208,210,255,.55); border-radius:34px; background:linear-gradient(145deg,rgba(255,255,255,.18),rgba(255,255,255,.035)); box-shadow:inset 0 1px rgba(255,255,255,.25),0 24px 60px rgba(0,0,0,.22); transform:rotate(-8deg); }
  .core-glyph { color:#fff; font:700 47px "Oxanium-Medium",var(--font-body); letter-spacing:-.08em; }
  .core-caption { margin-top:3px; color:#b9c1ff; font:8px "Oxanium-Medium",var(--font-body); letter-spacing:.12em; white-space:nowrap; }
  .visual-node { position:absolute; width:10px; height:10px; border:2px solid #a7a9ff; border-radius:50%; background:#252a66; box-shadow:0 0 16px #8e8bff; }
  .node-one { top:32px; left:24%; }.node-two { right:15%; top:48%; border-color:#77e3d6; box-shadow:0 0 16px #77e3d6; }.node-three { bottom:28px; left:30%; }
  .visual-label { position:absolute; padding:6px 9px; border:1px solid rgba(190,195,255,.2); border-radius:6px; background:rgba(15,22,57,.72); color:#d5d9ff; font:9px "Oxanium-Medium",var(--font-body); letter-spacing:.12em; }
  .label-one { top:22px; right:10%; }.label-two { left:2%; bottom:38px; }.label-three { right:0; bottom:26px; }
  .hero-bottom-line { width:min(1180px,100%); margin:35px auto 0; padding-top:14px; display:flex; justify-content:space-between; border-top:1px solid rgba(255,255,255,.13); color:rgba(218,223,255,.48); font:9px "Oxanium-Medium",var(--font-body); letter-spacing:.15em; }
  .welcome-section.compact { min-height:0; padding:92px 24px 44px; }
  .compact .hero-shell { display:block; min-height:0; width:min(1180px,100%); }
  .compact .hero-title { margin:13px 0 8px; font-size:clamp(28px,3.4vw,40px); }
  .compact .hero-content > p { font-size:13px; max-width:70ch; }
  .compact .hero-eyebrow { font-size:9px; }
  @media(max-width:900px) { .welcome-section { padding-top:100px; } .hero-shell { grid-template-columns:1fr .72fr; gap:16px; } .hero-visual { transform:scale(.86); } .hero-title { font-size:clamp(34px,5vw,52px); } }
  @media(max-width:680px) { .welcome-section { min-height:0; padding:91px 20px 36px; } .hero-shell { display:block; min-height:0; } .hero-title { font-size:clamp(34px,9vw,45px); margin:18px 0 12px; } .hero-content > p { font-size:13px; } .hero-visual { min-height:190px; margin:14px auto -4px; transform:scale(.72); transform-origin:center; } .hero-actions { align-items:flex-start; flex-direction:column; gap:14px; margin-top:20px; } .hero-proof { font-size:9px; } .hero-bottom-line { margin-top:18px; font-size:8px; gap:10px; } .welcome-section.compact { padding:82px 20px 32px; } .compact .hero-title { font-size:28px; } .compact .hero-content > p { font-size:12px; } }
  @media(prefers-reduced-motion:reduce) { .hero-primary { transition:none; } }
</style>
