---
import { t } from "../../i18n";
import { welcomeConfig } from "../../config";
import Waves from "./Waves.vue";
interface Props {
  compact?: boolean;
  title?: string;
  subtitle?: string;
  headingLevel?: 1 | 2;
}
const { compact = false, title, subtitle, headingLevel = 1 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<section
  class:list={["welcome-section", { compact }]}
  aria-label={title || welcomeConfig.title}
>
  {/*
    Hero 背景：纯 CSS 深色渐变（藏青 → 靛蓝 → 深青）+ 两处柔光，
    无图片、无网络请求，LCP 不受影响。
    2026-11-27：背景图 hero-refresh.webp 已移除（LCP 4.4s → 0.9s），
    旧的半透明遮罩在浅色底上发灰、文字对比度不足，改为实色深底。
  */}
  <div class="hero-content">
    <span class="hero-eyebrow">
      {compact ? t("hero.pageEyebrow") : t("hero.homeEyebrow")}
    </span>
    <Heading class="hero-title">
      {title || welcomeConfig.title}
      <span class="hero-sparkle" aria-hidden="true">
        ✧
      </span>
    </Heading>
    <p>{subtitle || welcomeConfig.subTitle}</p>
    <span class="hero-rule" aria-hidden="true"></span>
    {!compact && (
      <a href="#main-content" class="hero-explore">
        {t("hero.explore")}{" "}
        <span class="icon-[lucide--arrow-down]" aria-hidden="true"></span>
      </a>
    )}
  </div>
  <span class="hero-side-note" aria-hidden="true">
    {t("hero.sideNote")}
  </span>
  <Waves class="hero-waves" />
</section>
<style>
  .welcome-section {
    position: relative;
    /* Height is content-driven: top padding clears the 70px fixed header,
       so the eyebrow can never collide with the nav. */
    min-height: 400px;
    padding: 92px 20px 72px;
    /* Pure-CSS dark background: deep navy -> indigo -> deep teal,
       with two soft brand glows. No image, no fetch — LCP unaffected. */
    background:
      radial-gradient(
        ellipse 55% 75% at 78% 12%,
        rgb(8 168 157 / 0.28),
        transparent 62%
      ),
      radial-gradient(
        ellipse 45% 60% at 12% 88%,
        rgb(79 95 244 / 0.22),
        transparent 60%
      ),
      linear-gradient(118deg, #0a1230 0%, #121a3e 48%, #0b2a33 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    overflow: hidden;
  }
  .hero-content {
    position: relative;
    z-index: 3;
    padding: 0;
    text-shadow: 0 2px 18px rgb(0 0 0 / 35%);
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 7px 13px;
    border: 1px solid #ffffff40;
    border-radius: 999px;
    background: #ffffff1f;
    font-family: "Oxanium-Medium", var(--font-body);
    font-size: 11px;
    letter-spacing: 0.16em;
    margin-bottom: 20px;
  }
  .hero-content .hero-title {
    margin: 0 0 14px;
    font-size: clamp(34px, 4.2vw, 52px);
    letter-spacing: -0.02em;
    font-weight: 800;
    line-height: 1.12;
    text-shadow: 0 4px 24px rgb(0 0 0 / 35%);
  }
  .hero-sparkle {
    display: inline-block;
    font-size: 36px;
    margin-left: 12px;
    vertical-align: top;
    color: var(--accent-2);
    text-shadow: 0 0 24px color-mix(in srgb, var(--accent-2) 52%, transparent);
  }
  .hero-content p {
    font-size: 16px;
    letter-spacing: 0.01em;
    font-weight: 500;
    color: rgb(255 255 255 / 0.88);
    margin: 0 auto 22px;
    max-width: 60ch;
    line-height: 1.7;
  }
  .hero-rule {
    display: block;
    width: 64px;
    height: 3px;
    margin: 0 auto 24px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }
  .hero-explore {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.14);
    padding: 10px 20px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    box-shadow: 0 10px 30px rgb(0 0 0 / 30%);
  }
  .hero-explore:hover {
    background: rgb(255 255 255 / 0.22);
    transform: translateY(-2px);
  }
  .hero-side-note {
    position: absolute;
    right: 26px;
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    font-family: "Oxanium-Medium", var(--font-body);
    font-size: 9px;
    letter-spacing: 0.22em;
    opacity: 0.65;
  }
  .hero-waves {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    z-index: 2;
  }
  .hero-waves svg {
    height: 70px;
    min-height: 70px;
  }
  .welcome-section.compact {
    min-height: 0;
    padding: 84px 20px 48px;
  }
  .compact .hero-rule {
    display: none;
  }
  .compact .hero-content {
    padding-top: 0;
  }
  .compact .hero-content .hero-title {
    font-size: 34px;
  }
  .compact .hero-eyebrow {
    font-size: 10px;
    margin-bottom: 10px;
  }
  .compact .hero-content p {
    font-size: 13px;
  }
  @media (max-width: 760px) {
    .welcome-section {
      min-height: 320px;
      padding: 80px 20px 60px;
    }
    .hero-content {
      padding-top: 0;
    }
    .hero-content p {
      font-size: 14px;
      letter-spacing: 0.01em;
      line-height: 1.65;
    }
    .hero-eyebrow {
      font-size: 10px;
      letter-spacing: 0.12em;
      margin-bottom: 14px;
    }
    .hero-content .hero-title {
      font-size: 30px;
      line-height: 1.2;
    }
    .hero-sparkle {
      font-size: 24px;
      margin-left: 5px;
    }
    .hero-side-note {
      display: none;
    }
    .welcome-section.compact {
      padding: 76px 20px 40px;
    }
    .compact .hero-content .hero-title {
      font-size: 28px;
    }
  }
</style>
